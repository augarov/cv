{{ static.disclaimer }}

\documentclass[letterpaper,11pt]{jake-resume-ng}

\hypersetup{
    pdftitle={ {{- metadata.pdf_title -}} },
    pdfauthor={ {{- metadata.pdf_author -}} },
    pdfsubject={ {{- metadata.pdf_subject -}} },
    pdfkeywords={ {{- metadata.pdf_keywords -}} },
}

%%%%%%  RESUME STARTS HERE  %%%%%%%%%%%%%%%%%%%%%%%%%%%%

\begin{document}

%----------HEADING----------
\begin{center}
    \textbf{\Huge \scshape {{ personal.name.first | escape_latex }} {{ personal.name.last | escape_latex }}} \\ \vspace{1pt}
    \small
{% if personal.contact.phone %}
    {{ personal.contact.phone | format_phone | escape_latex }} $|$
{% endif %}
    \href{mailto:{{ personal.contact.email }}}{\underline{ {{- personal.contact.email | escape_latex -}} }}
{% if personal.contact.linkedin %}
    $|$ \href{ {{- personal.contact.linkedin.url -}} }{\underline{ {{- personal.contact.linkedin.display_name | escape_latex -}} }}
{% endif %}
{% if personal.contact.github %}
    $|$ \href{ {{- personal.contact.github.url -}} }{\underline{ {{- personal.contact.github.display_name | escape_latex -}} }}
{% endif %}
\end{center}

\sectionspace

%-----------PROFILE-----------
\section{Profile}
{{ personal.summary | markdown_latex }}

\sectionspace

%-----------EMPLOYMENT HISTORY-----------
\section{Employment History}
  \resumeSubHeadingListStart
{% for job in experience %}
    \resumeSubheading
      { {{- job.position | escape_latex -}} }{ {{- job.period | escape_latex -}} }
      { {{- job.company | escape_latex -}} }{ {{- job.location | escape_latex -}} }
{% if job.description %}
      \resumeSubsectionText{ {{- job.description | markdown_latex -}} }
{% endif %}
{% if job.achievements %}
      \resumeItemListStart
{% for achievement in job.achievements %}
        \resumeItem{ {{- achievement | markdown_latex -}} }
{% endfor %}
      \resumeItemListEnd
{% endif %}
{% if job.stack %}
      \resumeSubsectionText{\textbf{Technologies}: \textit{ {{- job.stack | escape_latex -}} }}
{% endif %}
{% endfor %}
  \resumeSubHeadingListEnd

\sectionspace

%-----------EDUCATION-----------
\section{Education}
  \resumeSubHeadingListStart
{% for edu in education %}
    \resumeSubheading
      { {{- edu.institution | escape_latex -}} }{ {{- edu.location | escape_latex -}} }
      { {{- edu.degree | escape_latex -}} }{ {{- edu.period | escape_latex -}} }
{% endfor %}
  \resumeSubHeadingListEnd

\sectionspace

%-----------SKILLS-----------
\section{Skills}
 \begin{itemize}[leftmargin=0.15in, label={}, topsep=0pt, parsep=0pt, partopsep=0pt]
    \small{\item{
{% for skill_category in skills %}
     \textbf{ {{- skill_category.category | escape_latex -}} }{: {% for skill in skill_category.skills %}{{ skill | escape_latex }}{% if not loop.last %}, {% endif %}{% endfor %}}{% if not loop.last %} \\{% endif %}

{% endfor %}
    }}
 \end{itemize}

{% if competitions %}
\sectionspace

%-----------COMPETITIONS-----------
\section{Competitions}
    \resumeSubHeadingListStart
{% for comp in competitions %}
      \resumeProjectHeading
          {\textbf{ {{- comp.title | escape_latex -}} }}{ {{- comp.date | escape_latex -}} }
          \resumeItemListStart
            \resumeItem{ {{- comp.description | markdown_latex -}} }
          \resumeItemListEnd
{% endfor %}
    \resumeSubHeadingListEnd
{% endif %}


%-------------------------------------------
\end{document}
