{{ static.disclaimer }}

\documentclass[letterpaper,11pt]{jake-resume-ng}

\hypersetup{
    pdftitle={ {{- metadata.pdf_title -}} },
    pdfauthor={ {{- metadata.pdf_author -}} },
    pdfsubject={ {{- metadata.pdf_subject -}} },
    pdfkeywords={ {{- metadata.pdf_keywords -}} },
}

%%%%%%  RESUME STARTS HERE  %%%%%%%%%%%%%%%%%%%%%%%%%%%%

\begin{document}

%----------HEADING----------
\begin{center}
    {\huge \scshape \textbf{ {{- personal.name.first | escape_latex }} {{ personal.name.last | escape_latex -}} , {{ personal.title | escape_latex -}} }} \\ \vspace{1pt}
    \small
    {{ personal.location | escape_latex }} $|$
{% if personal.contact.phone %}
    {{ personal.contact.phone | format_phone | escape_latex }} $|$
{% endif %}
    \href{mailto:{{ personal.contact.email }}}{\underline{ {{- personal.contact.email | escape_latex -}} }}
{% if personal.contact.linkedin %}
    $|$ \href{ {{- personal.contact.linkedin.url -}} }{\underline{ {{- personal.contact.linkedin.display_name | escape_latex -}} }}
{% endif %}
{% if personal.contact.github %}
    $|$ \href{ {{- personal.contact.github.url -}} }{\underline{ {{- personal.contact.github.display_name | escape_latex -}} }}
{% endif %}
\end{center}

\sectionspace

%-----------PROFILE-----------
\section{Profile}
{{ personal.summary | markdown_latex }}

\sectionspace

%-----------EMPLOYMENT HISTORY-----------
\section{Employment History}
  \resumeSubHeadingListStart
{% for job in experience %}
    \resumeSubheading
      { {{- job.position | escape_latex -}} }{ {{- job.period | escape_latex -}} }
      { {{- job.company | escape_latex -}} }{ {{- job.location | escape_latex -}} }
{% if job.description %}
      \resumeSubsectionText{ {{- job.description | markdown_latex -}} }
{% endif %}
{% if job.achievements %}
      \resumeItemListStart
{% for achievement in job.achievements %}
        \resumeItem{ {{- achievement | markdown_latex -}} }
{% endfor %}
      \resumeItemListEnd
{% endif %}
{% if job.stack %}
      \resumeSubsectionText{\textbf{Technologies}: \textit{ {{- job.stack | escape_latex -}} }}
{% endif %}
{% endfor %}
  \resumeSubHeadingListEnd

\sectionspace

%-----------EDUCATION-----------
\section{Education}
  \resumeSubHeadingListStart
{% for edu in education %}
    \resumeSubheading
      { {{- edu.institution | escape_latex -}} }{ {{- edu.period | escape_latex -}} }
      { {{- edu.degree | escape_latex -}} }{ {{- edu.location | escape_latex -}} }
{% if edu.description %}
      \resumeSubsectionText{ {{- edu.description | markdown_latex -}} }
{% endif %}
{% if edu.gpa %}
      \resumeSubsectionText{\textbf{GPA}: \textit{ {{- edu.gpa.cumulative | escape_latex -}} } (cumulative), \textit{ {{- edu.gpa.major | escape_latex -}} } (major)}
{% endif %}
{% endfor %}
  \resumeSubHeadingListEnd

\sectionspace

%-----------SKILLS-----------
\section{Skills}
  \resumeSubHeadingListStart
{% for skill_category in skills %}
{% if skill_category.category %}
    \resumeSkillCategoryHeading{ {{- skill_category.category | escape_latex -}} }
{% else %}
    \item
{% endif %}
    \resumeMulticolItemListStart{3}
{% for skill in skill_category.skills %}
      \resumeItem{ {{- skill | escape_latex -}} }
{% endfor %}
    \resumeMulticolItemListEnd
{% endfor %}
  \resumeSubHeadingListEnd

{% if competitions %}
\sectionspace

%-----------COMPETITIONS-----------
\section{Competitions}
    \resumeSubHeadingListStart
{% for comp in competitions %}
      \resumeProjectHeading
          {\textbf{ {{- comp.title | escape_latex -}} }}{ {{- comp.date | escape_latex -}} }
          \resumeSubsectionText{ {{- comp.description | markdown_latex -}} }
{% endfor %}
    \resumeSubHeadingListEnd
{% endif %}

{% if publications %}
\sectionspace

%-----------PUBLICATIONS-----------
\section{Publications}
  \resumeSubHeadingListStart
{% for pub in publications %}
    \resumeProjectHeading
        {\href{ {{- pub.link.url -}} }{ {{- pub.link.display_name | escape_latex -}} }}{ {{- pub.year -}} }
{% endfor %}
  \resumeSubHeadingListEnd
{% endif %}

{% if languages %}
\sectionspace

%-----------LANGUAGES-----------
\section{Languages}
  \resumeSubHeadingListStart
    \item
    \resumeMulticolItemListStart{3}
{% for lang in languages %}
      \resumeItem{\textbf{ {{- lang.language | escape_latex -}} }{: \textit{ {{- lang.level | escape_latex -}} }}}
{% endfor %}
    \resumeMulticolItemListEnd
  \resumeSubHeadingListEnd
{% endif %}


%-------------------------------------------
\end{document}
