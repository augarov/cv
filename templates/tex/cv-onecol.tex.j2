{{ static.disclaimer }}

\documentclass[]{deedy-resume}

\hypersetup{
    pdftitle={ {{- metadata.pdf_title  -}} },
    pdfauthor={ {{- metadata.pdf_author  -}} },
    pdfsubject={ {{- metadata.pdf_subject  -}} },
    pdfkeywords={ {{- metadata.pdf_keywords  -}} },
}

\title{ {{- metadata.pdf_title  -}} }
\author{ {{- metadata.pdf_author  -}} }
\date{\today}

\begin{document}

\lastupdated{ {{- format_current_time("%-d %B %Y") | escape_latex -}} }

%----------------------------------------------------------------------------------------
%   HEADER
%----------------------------------------------------------------------------------------

\namesection{ {{- personal.name.first | escape_latex -}} }{ {{- personal.name.last | escape_latex -}} }
{ {{- personal.title | escape_latex -}} }

\blockspace

%----------------------------------------------------------------------------------------
%   PROFILE
%----------------------------------------------------------------------------------------

\section{Profile}
\sectionspace

{{ personal.summary | markdown_latex }}

{{ personal.location | escape_latex }} \quad
\href{mailto:{{ personal.contact.email }}}{ {{- personal.contact.email | escape_latex -}} }{% if personal.contact.phone %} \quad
{{ personal.contact.phone | format_phone | escape_latex }}{% endif %}

\sectionspace

%----------------------------------------------------------------------------------------
%   LINKEDIN
%----------------------------------------------------------------------------------------
{% if personal.contact.linkedin %}

\section{LinkedIn}
\sectionspace

\href{ {{ personal.contact.linkedin.url }} }{ {{- personal.contact.linkedin.display_name | escape_latex -}} }

\sectionspace
{% endif %}

%----------------------------------------------------------------------------------------
%   EMPLOYMENT HISTORY
%----------------------------------------------------------------------------------------

\section{Employment History}
{% for job in experience %}

\runsubsection{ {{- job.company | escape_latex -}} }
\descript{| {{ job.position | escape_latex }}}
\location{ {{- job.period | escape_latex }} | {{ job.location | escape_latex }}}

{{ job.description | markdown_latex }}
\begin{descritemize}
{%- for achievement in job.achievements %}
    \descritem {{ achievement | markdown_latex }}
{%- endfor %}
\end{descritemize}
\textbf{Stack}: \textit{ {{- job.stack | escape_latex -}} }

\sectionspace
{% endfor %}

%----------------------------------------------------------------------------------------
%   EDUCATION
%----------------------------------------------------------------------------------------

\section{Education}
{% for edu in education %}

\runsubsection{ {{- edu.institution | escape_latex -}} } \\
\descript{ {{- edu.degree | escape_latex -}} }
\location{ {{- edu.period | escape_latex }} | {{ edu.location | escape_latex }}}
{{ edu.description | markdown_latex }}
{% if edu.gpa %}\textbf{Cum. GPA}: \textit{ {{- edu.gpa.cumulative | escape_latex -}} } \\
\textbf{Major GPA}: \textit{ {{- edu.gpa.major | escape_latex -}} }{% endif %}
{% endfor %}

\sectionspace

%----------------------------------------------------------------------------------------
%   SKILLS
%----------------------------------------------------------------------------------------

\section{Skills}
\sectionspace

{% for skill_category in skills %}
\textbf{ {{- skill_category.category | escape_latex -}} :} {{ skill_category.skills | join(", ") | escape_latex }} \\
{% endfor %}

\sectionspace

%----------------------------------------------------------------------------------------
%   PUBLICATIONS
%----------------------------------------------------------------------------------------
{% if publications %}

\section{Publications}
\sectionspace

{% for pub in publications %}
\href{ {{ pub.link.url }} }{\bf {{ pub.link.display_name | escape_latex }}} ({{ pub.year }}){% if not loop.last %} \\{% endif %}
{% endfor %}

\sectionspace
{% endif %}

%----------------------------------------------------------------------------------------
%   COMPETITIONS
%----------------------------------------------------------------------------------------
{% if competitions %}

\section{Competitions}
{% for comp in competitions %}

\runsubsection{ {{- comp.title | escape_latex -}} }
\location{ {{- comp.date | escape_latex -}} }

{{ comp.description | markdown_latex }}

\sectionspace
{% endfor %}
{% endif %}

%----------------------------------------------------------------------------------------
%   LANGUAGES
%----------------------------------------------------------------------------------------

\section{Languages}
\sectionspace

{% for lang in languages -%}
\textbf{ {{- lang.language | escape_latex -}} } / {{ lang.level | escape_latex }}{% if not loop.last %} \quad {% endif %}
{% endfor %}

\end{document}
