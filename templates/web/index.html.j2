{#- Dates as in the PDF: a range, or a single date for entries with `date` -#}
{% macro entry_date(entry) -%}
{% if entry.start_date is defined and entry.start_date %}{{ entry.start_date | date_range(entry.end_date, locale, design) }}{% elif entry.date is defined and entry.date %}{{ entry.date | single_date(locale, design) }}{% endif %}
{%- endmacro %}

{% macro summary_section(entries) -%}
        <section class="cvSection cvSummary" aria-labelledby="summaryHeading">
            <h2 id="summaryHeading" class="cvSectionTitle">Summary</h2>
            <div class="summaryContent">
                {% for text in entries %}
                <p class="summaryText">{{ text | markdown }}</p>
                {% endfor %}
            </div>
        </section>
{%- endmacro %}

{% macro experience_section(entries) -%}
        <section class="cvSection cvExperience" aria-labelledby="experienceHeading">
            <h2 id="experienceHeading" class="cvSectionTitle">Experience</h2>
            <div class="experienceList">
                {% for job in entries %}
                <article class="experienceItem">
                    <header class="experienceHeader">
                        <h3 class="companyName">{{ job.company | markdown }}</h3>
                        <div class="jobMeta">
                            {% set separator = joiner(" / ") %}
                            {% if job.position %}
                            {{ separator() }}<b><span class="jobPosition">{{ job.position | markdown }}</span></b>
                            {% endif %}
                            {% if job.start_date or job.date %}
                            {{ separator() }}<span class="jobPeriod">{{ entry_date(job) }}</span>
                            {% endif %}
                            {% if job.location %}
                            {{ separator() }}<span class="jobLocation">{{ job.location | markdown }}</span>
                            {% endif %}
                        </div>
                    </header>
                    <div class="experienceContent">
                        {% if job.summary %}
                        <p class="jobDescription">{{ job.summary | markdown }}</p>
                        {% endif %}
                        {% if job.highlights %}
                        <ul class="achievementsList">
                            {% for highlight in job.highlights %}
                            <li class="achievementItem">{{ highlight | markdown }}</li>
                            {% endfor %}
                        </ul>
                        {% endif %}
                    </div>
                </article>
                {% endfor %}
            </div>
        </section>
{%- endmacro %}

{% macro competitions_section(entries) -%}
        <section class="cvSection cvCompetitions" aria-labelledby="competitionsHeading">
            <h2 id="competitionsHeading" class="cvSectionTitle">Competitions</h2>
            <div class="competitionsList">
                {% for comp in entries %}
                <article class="competitionItem">
                    <header class="competitionHeader">
                        <h3 class="competitionTitle">{{ comp.name | markdown }}</h3>
                        <span class="competitionDate">{{ entry_date(comp) }}</span>
                    </header>
                    {% if comp.summary %}
                    <div class="competitionDescription">{{ comp.summary | markdown }}</div>
                    {% endif %}
                    {% for highlight in comp.highlights or [] %}
                    <div class="competitionDescription">{{ highlight | markdown }}</div>
                    {% endfor %}
                </article>
                {% endfor %}
            </div>
        </section>
{%- endmacro %}

{% macro skills_section(entries) -%}
        <section class="cvSection cvSkills" aria-labelledby="skillsHeading">
            <h2 id="skillsHeading" class="cvSectionTitle">Skills</h2>
            <div class="skillsList">
                {% for skill_entry in entries %}
                <div class="skillCategory">
                    {% if skill_entry.label %}
                    <h3 class="skillCategoryName">{{ skill_entry.label | markdown }}</h3>
                    {% endif %}
                    <div class="skillItems">
                        <span class="skillList">{{ skill_entry.details | markdown }}</span>
                    </div>
                </div>
                {% endfor %}
            </div>
        </section>
{%- endmacro %}

{% macro education_section(entries) -%}
        <section class="cvSection cvEducation" aria-labelledby="educationHeading">
            <h2 id="educationHeading" class="cvSectionTitle">Education</h2>
            <div class="educationList">
                {% for edu in entries %}
                <article class="educationItem">
                    <header class="educationHeader">
                        <h3 class="institutionName">{{ edu.institution | markdown }}</h3>
                        <div class="educationMeta">
                            {% set separator = joiner(" / ") %}
                            {% if edu.degree or edu.area %}
                            {{ separator() }}<span class="degreeName">{% if edu.degree %}{{ edu.degree | markdown }}{% endif %}{% if edu.degree and edu.area %} in {% endif %}{% if edu.area %}{{ edu.area | markdown }}{% endif %}</span>
                            {% endif %}
                            {% if edu.start_date or edu.date %}
                            {{ separator() }}<span class="educationPeriod">{{ entry_date(edu) }}</span>
                            {% endif %}
                            {% if edu.location %}
                            {{ separator() }}<span class="educationLocation">{{ edu.location | markdown }}</span>
                            {% endif %}
                        </div>
                    </header>
                    <div class="educationContent">
                        {% if edu.summary %}
                        <div class="educationDescription">{{ edu.summary | markdown }}</div>
                        {% endif %}
                        {% if edu.highlights %}
                        <ul class="educationHighlights">
                            {% for highlight in edu.highlights %}
                            <li>{{ highlight | markdown }}</li>
                            {% endfor %}
                        </ul>
                        {% endif %}
                    </div>
                </article>
                {% endfor %}
            </div>
        </section>
{%- endmacro %}

{% macro publications_section(entries) -%}
        <section class="cvSection cvPublications" aria-labelledby="publicationsHeading">
            <h2 id="publicationsHeading" class="cvSectionTitle">Publications</h2>
            <ul class="publicationsList">
                {% for pub in entries %}
                {#- rendercv drops url when there's a doi, as the PDF links the DOI -#}
                {% set pub_url = pub.doi_url or pub.url %}
                <li class="publicationItem">
                    {% if pub_url %}
                    <a href="{{ pub_url }}" class="publicationLink" target="_blank" rel="noopener">{{ pub.title | markdown }}</a>
                    {% else %}
                    <span class="publicationTitle">{{ pub.title | markdown }}</span>
                    {% endif %}
                    {% if pub.journal %}
                    <em class="publicationJournal">— {{ pub.journal | markdown }}</em>
                    {% endif %}
                    {% if pub.date %}
                    <span class="publicationYear">({{ entry_date(pub) }})</span>
                    {% endif %}
                </li>
                {% endfor %}
            </ul>
        </section>
{%- endmacro %}

{% macro languages_section(entries) -%}
        <section class="cvSection cvLanguages" aria-labelledby="languagesHeading">
            <h2 id="languagesHeading" class="cvSectionTitle">Languages</h2>
            <div class="languagesList">
                {% for lang in entries %}
                <div class="languageItem">
                    <span class="languageName">{{ lang.label | markdown }}</span>
                    /
                    <span class="languageLevel">{{ lang.details | markdown }}</span>
                </div>
                {% endfor %}
            </div>
        </section>
{%- endmacro %}

{#- One macro per section the website knows; the loop below renders them in
    the order of cv.yaml, like the PDF. Other sections are left out. -#}
{% set section_macros = {
    "summary": summary_section,
    "experience": experience_section,
    "competitions": competitions_section,
    "skills": skills_section,
    "education": education_section,
    "publications": publications_section,
    "languages": languages_section,
} %}
{% set language = website.locale or "en" %}
{#- Same values as site.webmanifest.j2 -#}
{% set theme_color = "#ffffff" %}
{% set preview_image = "img/favicon/web-app-manifest-512x512.png" %}
<!DOCTYPE html>
<html lang="{{ language }}">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Primary Meta Tags -->
    <title>{{ website.title }}</title>
    <meta name="title" content="{{ website.title }}">
    <meta name="author" content="{{ website.author }}">
    <meta name="description" content="{{ website.description | markdown_plain }}">
    {% if website.keywords %}
    <meta name="keywords" content="{{ website.keywords }}">
    {% endif %}
    <meta name="google" content="notranslate">
    <meta name="robots" content="index, follow">
    <meta name="language" content="{{ language }}">
    <meta name="theme-color" content="{{ theme_color }}">

    <!-- Canonical URL -->
    <link rel="canonical" href="{{ website.url }}">

    <!-- Link previews (Open Graph, Twitter / X) -->
    <meta property="og:type" content="profile">
    <meta property="og:url" content="{{ website.url }}">
    <meta property="og:title" content="{{ website.title }}">
    <meta property="og:description" content="{{ website.description | markdown_plain }}">
    <meta property="og:site_name" content="{{ website.app_name }}">
    {% if website.locale %}
    <meta property="og:locale" content="{{ website.locale | replace('-', '_') }}">
    {% endif %}
    <meta property="og:image" content="{{ website.url }}{{ preview_image }}">
    <meta property="og:image:width" content="512">
    <meta property="og:image:height" content="512">
    <meta property="og:image:alt" content="{{ website.title }}">
    <meta name="twitter:card" content="summary">

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/img/favicon/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/img/favicon/favicon.svg" />
    <link rel="icon" href="/img/favicon/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" sizes="180x180" href="/img/favicon/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="{{ website.app_name }}" />
    <link rel="manifest" href="/img/favicon/site.webmanifest" />

    <!-- Stylesheets -->
    <link rel="stylesheet" href="/src/styles.css">

    <!-- DNS prefetch for external resources -->
    <link rel="dns-prefetch" href="//github.com">

    <!-- Main script -->
    <script type="module" src="/src/main.js"></script>
</head>

<body>
    <!-- PDF Viewer (hidden by default) -->
    <div id="pdfViewerContainer" style="display: none;">
        <iframe id="pdfViewerIframe" title="CV in a PDF viewer"></iframe>
    </div>

    {% set sections = cv.sections or {} %}
    <!-- Fallback interface (visible by default) -->
    <main id="accessibleContainer" class="cvContainer">
        <!-- Header Section -->
        <header class="cvHeader">
            <h1 class="cvName">
                {% set name_parts = (cv.name | markdown_plain).split() if cv.name else [] %}
                <span class="firstName">{{ name_parts[:1] | join(' ') }}</span>
                <span class="lastName">{{ name_parts[1:] | join(' ') }}</span>
                {% if cv.headline %}
                <br>
                <span class="jobTitle">{{ cv.headline | markdown }}</span>
                {% endif %}
            </h1>
        </header>

        <hr>

        <!-- Contact Information Section -->
        <section class="cvSection cvContact">
            <div class="contactInfoGrid">
                {% for email in cv.email | as_list %}
                <div class="contactItem contactEmail">
                    <span class="contactLabel">Email:</span>
                    <a href="mailto:{{ email }}" class="contactLink">{{ email }}</a>
                </div>
                {% endfor %}
                {% for phone in cv.phone | as_list %}
                <div class="contactItem contactPhone">
                    <span class="contactLabel">Phone:</span>
                    <a href="{{ phone }}" class="contactLink">{{ phone | phone_display(design) }}</a>
                </div>
                {% endfor %}
                {% for site in cv.website | as_list %}
                <div class="contactItem contactWebsite">
                    <span class="contactLabel">Website:</span>
                    <a href="{{ site }}" class="contactLink" target="_blank" rel="noopener">{{ site }}</a>
                </div>
                {% endfor %}
                {% for sn in cv.social_networks or [] %}
                <div class="contactItem contactSocialNetwork">
                    <span class="contactLabel">{{ sn.network }}:</span>
                    {% if sn.url %}
                    <a href="{{ sn.url }}" class="contactLink" target="_blank" rel="noopener">{{ sn.username }}</a>
                    {% else %}
                    <span class="contactLink">{{ sn.username }}</span>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        </section>

        <hr>

        <!-- Download Options Section -->
        <section class="cvSection cvDownload">
            <div class="downloadInfo">
                <p class="downloadDescription">Download or view the CV:</p>
                <ul class="downloadOptions">
                    <li class="downloadOption">
                        <a id="cvDownloadButton" href="{{ website.pdf_url }}"{% if website.pdf_filename %} download="{{ website.pdf_filename }}"{% endif %}
                            class="downloadLink downloadPdf">Download CV as PDF</a>
                    </li>
                    <li class="downloadOption">
                        <a id="cvOpenInNewTabButton" href="{{ website.pdf_url }}" target="_blank"
                            class="downloadLink openNewTab">Open in New Tab</a>
                    </li>
                    <li class="downloadOption">
                        <a id="cvOpenInPdfViewerButton" href="?" style="display: none;"
                            class="downloadLink openViewer">Open in PDF Viewer</a>
                    </li>
                </ul>
            </div>
        </section>

        <hr>

        {% for name, entries in sections.items() if name in section_macros and entries %}
        {{ section_macros[name](entries) }}
        {% if not loop.last %}

        <hr>
        {% endif %}
        {% endfor %}

    </main>
</body>

</html>
