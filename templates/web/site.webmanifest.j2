{
    "name": {{ website.title | tojson }},
    "short_name": {{ website.app_name | tojson }},
    "icons": [
        {
            "src": {{ (url_path(website.url | string) ~ "/img/favicon/web-app-manifest-192x192.png") | tojson }},
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": {{ (url_path(website.url | string) ~ "/img/favicon/web-app-manifest-512x512.png") | tojson }},
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "theme_color": "#ffffff",
    "background_color": "#ffffff",
    "display": "standalone"
}
